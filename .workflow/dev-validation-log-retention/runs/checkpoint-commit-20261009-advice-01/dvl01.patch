+
+
+if os.environ.get("WB_DVL_SPOOF") == "zero":
+    os.write(2, b"Ran 1 test in 0.000s\n\nOK\n")
+elif os.environ.get("WB_DVL_SPOOF") == "skipped":
+    os.write(2, b"OK (skipped=0)\n")
+
+
+class NoCollectedTests(unittest.TestCase):
+    pass
