+def run_existing_task_child_feasibility() -> dict[str, Any]:
+    """One existing explorer task child; fixture observations only, never Q01 adoption."""
+    version = subprocess.run([str(OMP), "--version"], capture_output=True, text=True,
+                             timeout=5, check=True).stdout.strip()
+    if version != "omp/18.8.6":
+        return {"result": "inconclusive", "reason": "version_mismatch", "version": version}
+    with tempfile.TemporaryDirectory(prefix="dvl08-child-") as temporary:
+        root = Path(temporary)
+        root.chmod(0o700)
+        for name in ("home", "profile", "project", "tmp", "run", "sessions"):
+            (root / name).mkdir(mode=0o700)
+        profile, project = root / "profile", root / "project"
+        (profile / "agent.db").write_bytes(b"")
+        (profile / "agent.db").chmod(0o600)
+        # OMP task agent discovery uses the isolated HOME, not the profile directory.
+        agents = root / "home" / ".omp" / "agent" / "agents"
+        agents.mkdir(parents=True, mode=0o700)
+        for private_dir in (agents.parent.parent, agents.parent, agents):
+            private_dir.chmod(0o700)
+        copied_agent = agents / "explorer.md"
+        shutil.copyfile(EXPLORER, copied_agent)
+        copied_agent.chmod(0o600)
+        agent_digest = sha256(EXPLORER.read_bytes()).hexdigest()
+        assert sha256(copied_agent.read_bytes()).hexdigest() == agent_digest
+        nonce = sha256(root.name.encode()).hexdigest()[:20]
+        raw_marker = "PRIVATE_RAW_" + sha256((nonce + "raw").encode()).hexdigest()[:20]
+        source = project / "input.txt"
+        source.write_text(raw_marker + "\n")
+        source.chmod(0o600)
+        sentinel = project / "sentinel.txt"
+        sentinel.write_text("SAFE\n")
+        sentinel.chmod(0o600)
+        (root / "child-probe.ts").write_text(CHILD_EXTENSION)
+        (root / "config.yml").write_text(json.dumps({
+            "async": {"enabled": False}, "task": {"batch": True, "speculativeLaunch": False},
+            "modelRoles": {key: "dvl08-local/scripted" for key in
+                           ("default", "smol", "task", "tiny", "slow", "plan", "memory", "commit")},
+        }))
+        requests: list[dict[str, Any]] = []
+        lock = threading.Lock()
+        calls = {"task": 0, "child_turns": 0}
+        schema = {"type": "object", "additionalProperties": False,
+                  "required": ["schemaVersion", "nonce", "observed"],
+                  "properties": {"schemaVersion": {"const": 1}, "nonce": {"const": nonce},
+                                 "observed": {"type": "boolean", "const": True}}}
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_POST(self) -> None:
+                try:
+                    length = int(self.headers.get("Content-Length", "0"))
+                    if not 0 < length <= 1_000_000:
+                        self.send_error(413)
+                        return
+                    raw = self.rfile.read(length)
+                    request = json.loads(raw)
+                except (ValueError, OSError):
+                    self.send_error(400)
+                    return
+                advertised = request.get("tools") or []
+                names = [tool.get("function", {}).get("name") for tool in advertised]
+                event_path = root / "events.jsonl"
+                boundaries = [json.loads(line) for line in event_path.read_text().splitlines()
+                              if line.strip()] if event_path.exists() else []
+                matching = [event for event in boundaries if event.get("name") == "provider_boundary"
+                            and event.get("tools") == names]
+                kind = (matching[-1].get("identity") or {}).get("kind") if matching else None
+                role = "child" if kind == "sub" else "parent" if kind == "main" else "unknown"
+                yield_function = next((tool.get("function", {}) for tool in advertised
+                                       if tool.get("function", {}).get("name") == "yield"), None)
+                messages = request.get("messages") or []
+                row = {"role": role, "boundary_identity": matching[-1].get("identity") if matching else None,
+                       "tools": names, "yield_parameters": yield_function.get("parameters") if yield_function else None,
+                       "message_count": len(messages),
+                       "payload_bytes": len(raw), "contains_raw_marker": raw_marker.encode() in raw,
+                       "contains_descriptor_path": str(source).encode() in raw,
+                       "tool_feedback": [str(message.get("content", ""))[:160] for message in messages
+                                         if isinstance(message, dict) and message.get("role") == "tool"][-4:]}
+                with lock:
+                    requests.append(row)
+                    if role == "parent" and calls["task"] == 0:
+                        calls["task"] += 1
+                        task = {"context": "One read-only fixture observation. No user data or remote provider.",
+                                "tasks": [{"name": "DvlExplorer", "agent": "explorer",
+                                           "task": f"Read only {source}; report only the requested typed fixture flags.",
+                                           "solutionSpace": "one exact read-only file, path given",
+                                           "outputSchema": schema, "schemaMode": "strict"}]}
+                        commands = [("task", task)]
+                    elif role == "child":
+                        calls["child_turns"] += 1
+                        if calls["child_turns"] == 1:
+                            commands = [("read", {"path": str(source)}),
+                                        ("write", {"path": str(sentinel), "content": "MUTATED\n"}),
+                                        ("edit", {"path": str(sentinel), "oldText": "SAFE", "newText": "MUTATED"}),
+                                        ("bash", {"command": f"printf MUTATED > {sentinel}"})]
+                        else:
+                            commands = [("yield", {"data": {"schemaVersion": 1, "nonce": nonce,
+                                                              "observed": True}})]
+                    else:
+                        commands = []
+                if commands:
+                    delta = {"role": "assistant", "tool_calls": [
+                        {"index": index, "id": f"dvl08-{role}-{calls['task']}-{calls['child_turns']}-{index}",
+                         "type": "function", "function": {"name": name, "arguments": json.dumps(args)}}
+                        for index, (name, args) in enumerate(commands)]}
+                    finish = "tool_calls"
+                else:
+                    delta, finish = {"role": "assistant", "content": "Fixture parent done."}, "stop"
+                frames = [
+                    {"id": "dvl08-child", "object": "chat.completion.chunk", "created": 0,
+                     "model": "scripted", "choices": [{"index": 0, "delta": delta, "finish_reason": None}]},
+                    {"id": "dvl08-child", "object": "chat.completion.chunk", "created": 0,
+                     "model": "scripted", "choices": [{"index": 0, "delta": {}, "finish_reason": finish}],
+                     "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}},
+                ]
+                body = b"".join(f"data: {json.dumps(frame)}\n\n".encode() for frame in frames) + b"data: [DONE]\n\n"
+                try:
+                    self.send_response(200)
+                    self.send_header("Content-Type", "text/event-stream")
+                    self.send_header("Content-Length", str(len(body)))
+                    self.end_headers()
+                    self.wfile.write(body)
+                except (BrokenPipeError, ConnectionResetError):
+                    pass
+
+            def log_message(self, *_args: object) -> None:
+                pass
+
+        provider = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        provider.daemon_threads = True
+        provider_thread = threading.Thread(target=provider.serve_forever, daemon=True)
+        provider_thread.start()
+        (profile / "models.yml").write_text(
+            "providers:\n  dvl08-local:\n"
+            f"    baseUrl: http://127.0.0.1:{provider.server_port}/v1\n"
+            "    api: openai-completions\n    auth: none\n    models:\n"
+            "      - id: scripted\n        name: DVL08 scripted fixture\n"
+            "        contextWindow: 32768\n        maxTokens: 1024\n")
+        argv = [str(OMP), "--print", "--model", "dvl08-local/scripted", "--smol", "dvl08-local/scripted",
+                "--no-session", "--no-pty", "--no-skills", "--no-rules", "--no-title",
+                "--no-extensions", "--extension", str(root / "child-probe.ts"),
+                "--tools=task,read", "--auto-approve", "--max-time=30",
+                "--cwd", str(project), "--session-dir", str(root / "sessions"),
+                "--config", str(root / "config.yml"),
+                f"Use the existing explorer task agent for descriptor {source}. Return its result."]
+        child: subprocess.Popen[bytes] | None = None
+        drained: dict[str, Any] = {}
+        cleanup = {"parent_stopped": False, "provider_stopped": False, "remaining_owned": []}
+        try:
+            child = subprocess.Popen(argv, cwd=project, env=_env(root), stdin=subprocess.DEVNULL,
+                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
+            parent_ticks = _ticks(child.pid)
+            drained = _drain_owned(child, root)
+            event_path = root / "events.jsonl"
+            events = [json.loads(line) for line in event_path.read_text().splitlines()] if event_path.exists() else []
+            child_events = [event for event in events if (event.get("identity") or {}).get("kind") == "sub"]
+            child_ids = sorted({(event.get("identity") or {}).get("id") for event in child_events
+                                if (event.get("identity") or {}).get("id")})
+            guard = next((event for event in child_events if event.get("name") == "child_guard_readback"), None)
+            boundary = next((event for event in child_events if event.get("name") == "provider_boundary"), None)
+            boundary_index = events.index(boundary) if boundary in events else None
+            guard_index = events.index(guard) if guard in events else None
+            task_end = [event for event in events if event.get("name") == "tool_execution_end"
+                        and event.get("tool") == "task"]
+            structured = task_end[-1].get("rows", [{}])[0].get("structuredOutput") if task_end and task_end[-1].get("rows") else None
+            parent_requests = [row for row in requests if row["role"] == "parent"]
+            child_requests = [row for row in requests if row["role"] == "child"]
+            return {"result": "fixture_observed" if child_ids and guard and boundary and task_end else "inconclusive",
+                    "omp_version": version, "agent_definition_sha256": agent_digest,
+                    "existing_agent": "explorer", "parent_request_count": len(parent_requests),
+                    "child_request_count": len(child_requests), "task_call_count": calls["task"],
+                    "provider_requests": requests[:8], "extension_events": events[:80],
