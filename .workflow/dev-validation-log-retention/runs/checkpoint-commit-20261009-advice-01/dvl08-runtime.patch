+def run_guard_feasibility() -> dict[str, Any]:
+    version = subprocess.run([str(OMP), "--version"], capture_output=True, text=True,
+                             timeout=5, check=True).stdout.strip()
+    if version != "omp/18.8.6":
+        return {"result": "inconclusive", "reason": "version_mismatch", "version": version}
+    with tempfile.TemporaryDirectory(prefix="dvl08-guard-") as temporary:
+        root = Path(temporary)
+        root.chmod(0o700)
+        for name in ("home", "profile", "project", "tmp", "run"):
+            (root / name).mkdir(mode=0o700)
+        profile, project = root / "profile", root / "project"
+        (profile / "agent.db").write_bytes(b"")
+        (profile / "agent.db").chmod(0o600)
+        sentinel, edit_target, bash_target = (project / name for name in
+                                               ("sentinel.txt", "edit.txt", "bash.txt"))
+        sentinel.write_text("SAFE\n")
+        edit_target.write_text("SAFE\n")
+        (root / "guard.ts").write_text(EXTENSION)
+        (root / "config.yml").write_text("# isolated probe\n")
+        requests: list[dict[str, Any]] = []
+        lock = threading.Lock()
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_POST(self) -> None:
+                raw = self.rfile.read(int(self.headers.get("Content-Length", "0")))
+                try:
+                    request = json.loads(raw)
+                except ValueError:
+                    self.send_error(400)
+                    return
+                selected = [t.get("function", {}).get("name") for t in request.get("tools", [])]
+                feedback = [
+                    {"tool_call_id": message.get("tool_call_id"),
+                     "content": str(message.get("content", ""))[:300]}
+                    for message in request.get("messages", [])
+                    if isinstance(message, dict) and message.get("role") == "tool"
+                ]
+                with lock:
+                    index = len(requests) + 1
+                    requests.append({"index": index, "path": self.path,
+                                     "selected_tools": selected, "tool_feedback": feedback})
+                if index == 1:
+                    calls = [
+                        ("read", {"path": str(sentinel)}),
+                        ("write", {"path": str(sentinel), "content": "MUTATED\n"}),
+                        ("edit", {"path": str(edit_target), "oldText": "SAFE", "newText": "MUTATED"}),
+                        ("bash", {"command": f"printf MUTATED > {bash_target}"}),
+                    ]
+                    delta = {"role": "assistant", "tool_calls": [
+                        {"index": i, "id": f"dvl08-hostile-{i}", "type": "function",
+                         "function": {"name": name, "arguments": json.dumps(args)}}
+                        for i, (name, args) in enumerate(calls)]}
+                    finish = "tool_calls"
+                else:
+                    delta, finish = {"role": "assistant", "content": "Fixture complete."}, "stop"
+                frames = [
+                    {"id": "dvl08", "object": "chat.completion.chunk", "created": 0,
+                     "model": "scripted", "choices": [{"index": 0, "delta": delta, "finish_reason": None}]},
+                    {"id": "dvl08", "object": "chat.completion.chunk", "created": 0,
+                     "model": "scripted", "choices": [{"index": 0, "delta": {}, "finish_reason": finish}],
+                     "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}},
+                ]
+                data = b"".join(f"data: {json.dumps(frame)}\n\n".encode() for frame in frames)
+                data += b"data: [DONE]\n\n"
+                try:
+                    self.send_response(200)
+                    self.send_header("Content-Type", "text/event-stream")
+                    self.send_header("Content-Length", str(len(data)))
+                    self.end_headers()
+                    self.wfile.write(data)
+                except (BrokenPipeError, ConnectionResetError):
+                    pass
+
+            def log_message(self, *_args: object) -> None:
