+                "--cwd", str(project), "--session-dir", str(root / "sessions"),
+                "--config", str(root / "config.yml"), "Run the isolated scripted fixture."]
+        child: subprocess.Popen[bytes] | None = None
+        child_ticks: int | None = None
+        output = b""
+        cleanup = {"child_stopped": False, "provider_stopped": False}
+        try:
+            child = subprocess.Popen(argv, cwd=project, env=_env(root), stdin=subprocess.DEVNULL,
+                                     stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                     start_new_session=True)
+            child_ticks = _ticks(child.pid)
+            try:
+                output, _ = child.communicate(timeout=35)
+            except subprocess.TimeoutExpired:
+                if child_ticks is not None and _ticks(child.pid) == child_ticks:
+                    os.killpg(child.pid, signal.SIGTERM)
+                try:
+                    output, _ = child.communicate(timeout=3)
+                except subprocess.TimeoutExpired:
+                    if child_ticks is not None and _ticks(child.pid) == child_ticks:
+                        os.killpg(child.pid, signal.SIGKILL)
+                    output, _ = child.communicate(timeout=3)
+            event_path = root / "events.jsonl"
+            events = [json.loads(line) for line in event_path.read_text().splitlines()] if event_path.exists() else []
+            blocked = {e.get("tool") for e in events if e.get("name") == "tool_call" and e.get("block") is True}
+            executed = {e.get("tool") for e in events if e.get("name") == "tool_execution_start"}
+            ends = {e.get("tool"): e for e in events if e.get("name") == "tool_execution_end"}
+            read_hook = any(e.get("name") == "tool_call" and e.get("tool") == "read"
+                            and e.get("block") is False for e in events)
+            read_ok = read_hook and ends.get("read", {}).get("event_is_error") is False
+            hostile = {"write", "edit", "bash"}
+            hostile_error = all(
+                tool in ends and ends[tool].get("event_is_error") is True and
+                ends[tool].get("result_content") == [f"Tool {tool} not found"]
+                for tool in hostile
+            )
+            unchanged = sentinel.read_text() == "SAFE\n" and edit_target.read_text() == "SAFE\n" and not bash_target.exists()
+            readback = any(e.get("name") == "guard_readback" and e.get("ready") is True
+                           and e.get("tools") == ["read"] for e in events)
+            if readback and read_ok and hostile_error and unchanged and not blocked:
+                result = "inactive_lookup_rejected"
+            elif readback and read_ok and blocked == hostile and hostile_error and unchanged:
+                result = "tool_call_guard_blocked"
+            else:
+                result = "inconclusive"
+            return {
+                "result": result, "omp_version": version, "provider_port": provider.server_port,
+                "provider_requests": requests, "extension_events": events,
+                "allowed_read_hook_observed": read_hook, "allowed_read_result_ok": read_ok,
+                "hostile_end_errors_observed": hostile_error,
+                "blocked_tool_call_hooks": sorted(str(x) for x in blocked),
+                "tool_execution_start_names": sorted(str(x) for x in executed),
+                "sentinel_unchanged": sentinel.read_text() == "SAFE\n",
+                "edit_unchanged": edit_target.read_text() == "SAFE\n",
+                "bash_target_absent": not bash_target.exists(),
+                "child_pid": child.pid, "child_start_ticks": child_ticks,
+                "child_exit": child.returncode, "output_bytes_drained": len(output),
+                "output_discarded": True, "guard_epoch_nonce_atomic_send": "unknown",
+                "product_route": "unavailable", "cleanup": cleanup,
+            }
+        finally:
+            if child is not None and child.poll() is None:
+                if child_ticks is not None and _ticks(child.pid) == child_ticks:
+                    os.killpg(child.pid, signal.SIGKILL)
+                child.communicate(timeout=3)
+            cleanup["child_stopped"] = child is None or child.poll() is not None
+            provider.shutdown()
+            provider.server_close()
+            provider_thread.join(timeout=3)
+            cleanup["provider_stopped"] = not provider_thread.is_alive()
+
