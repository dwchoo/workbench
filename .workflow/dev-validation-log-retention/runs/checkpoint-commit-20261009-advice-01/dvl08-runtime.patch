+def run_native_executor_child_feasibility() -> dict[str, Any]:
+    """One OMP lifecycle, exact existing explorer, deterministic public executor; fixture only."""
+    version = subprocess.run([str(OMP), "--version"], capture_output=True, text=True,
+                             timeout=5, check=True).stdout.strip()
+    if version != "omp/18.8.6":
+        return {"result": "inconclusive", "reason": "version_mismatch", "omp_version": version}
+    with tempfile.TemporaryDirectory(prefix="dvl08-native-child-") as temporary:
+        root = Path(temporary)
+        root.chmod(0o700)
+        for name in ("home", "profile", "project", "tmp", "run", "sessions"):
+            (root / name).mkdir(mode=0o700)
+        profile, project = root / "profile", root / "project"
+        (profile / "agent.db").write_bytes(b"")
+        (profile / "agent.db").chmod(0o600)
+        agents = root / "home" / ".omp" / "agent" / "agents"
+        agents.mkdir(parents=True, mode=0o700)
+        for private_dir in (agents.parent.parent, agents.parent, agents):
+            private_dir.chmod(0o700)
+        copied_agent = agents / "explorer.md"
+        shutil.copyfile(EXPLORER, copied_agent)
+        copied_agent.chmod(0o600)
+        agent_digest = sha256(EXPLORER.read_bytes()).hexdigest()
+        assert sha256(copied_agent.read_bytes()).hexdigest() == agent_digest
+        source = project / "input.txt"
+        raw_marker = "PRIVATE_RAW_" + sha256(root.name.encode()).hexdigest()[:20]
+        source.write_text(raw_marker + "\n")
+        source.chmod(0o600)
+        sentinel = project / "sentinel.txt"
+        sentinel.write_text("SAFE\n")
+        sentinel.chmod(0o600)
+        bash_target = project / "bash-target.txt"
+        extension = root / "native-child.ts"
+        extension.write_text(NATIVE_CHILD_EXTENSION)
+        (root / "config.yml").write_text(json.dumps({
+            "async": {"enabled": False}, "task": {"batch": False, "speculativeLaunch": False},
+            "modelRoles": {key: "dvl08-local/scripted" for key in
+                           ("default", "smol", "task", "tiny", "slow", "plan", "memory", "commit")},
+        }))
+        requests: list[dict[str, Any]] = []
+        lock = threading.Lock()
+        calls = {"positive": 0, "negative": 0, "parent": 0, "unknown": 0}
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_POST(self) -> None:
+                try:
+                    length = int(self.headers.get("Content-Length", "0"))
+                    if not 0 < length <= 1_000_000:
+                        self.send_error(413)
+                        return
+                    raw = self.rfile.read(length)
+                    request = json.loads(raw)
+                except (ValueError, OSError):
+                    self.send_error(400)
+                    return
+                names = [tool.get("function", {}).get("name") for tool in request.get("tools") or []]
+                event_path = root / "events.jsonl"
+                events = [json.loads(line) for line in event_path.read_text().splitlines()
+                          if line.strip()] if event_path.exists() else []
+                boundary = next((event for event in reversed(events)
+                                 if event.get("name") == "child_provider_boundary"), None)
+                phase = boundary.get("phase") if boundary else "unknown"
+                if phase not in calls:
+                    phase = "unknown"
+                with lock:
+                    calls[phase] += 1
+                    ordinal = calls[phase]
+                    requests.append({"phase": phase, "ordinal": ordinal, "tools": names,
+                                     "identity": boundary.get("identity") if boundary else None,
+                                     "contains_raw_marker": raw_marker.encode() in raw,
+                                     "contains_descriptor_path": str(source).encode() in raw,
+                                     "message_count": len(request.get("messages") or []),
+                                     "payload_bytes": len(raw)})
+                if phase == "positive" and ordinal == 1:
+                    commands = [("read", {"path": str(source)}),
+                                ("write", {"path": str(sentinel), "content": "MUTATED\n"}),
+                                ("edit", {"path": str(sentinel), "oldText": "SAFE", "newText": "MUTATED"}),
+                                ("bash", {"command": f"printf MUTATED > {bash_target}"})]
+                elif phase == "positive" and ordinal <= 3:
+                    commands = [("yield", {"data": {"schemaVersion": 1, "nonce": root.name,
+                                                    "observed": True}})]
+                else:
+                    commands = []
+                if commands:
+                    delta = {"role": "assistant", "tool_calls": [
+                        {"index": index, "id": f"dvl08-native-{phase}-{ordinal}-{index}",
+                         "type": "function", "function": {"name": name, "arguments": json.dumps(args)}}
+                        for index, (name, args) in enumerate(commands)]}
+                    finish = "tool_calls"
+                else:
+                    delta, finish = {"role": "assistant", "content": "Fixture stopped."}, "stop"
+                frames = [
+                    {"id": "dvl08-native", "object": "chat.completion.chunk", "created": 0,
+                     "model": "scripted", "choices": [{"index": 0, "delta": delta, "finish_reason": None}]},
+                    {"id": "dvl08-native", "object": "chat.completion.chunk", "created": 0,
+                     "model": "scripted", "choices": [{"index": 0, "delta": {}, "finish_reason": finish}],
+                     "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}},
+                ]
+                body = b"".join(f"data: {json.dumps(frame)}\n\n".encode() for frame in frames) + b"data: [DONE]\n\n"
+                try:
+                    self.send_response(200)
+                    self.send_header("Content-Type", "text/event-stream")
+                    self.send_header("Content-Length", str(len(body)))
+                    self.end_headers()
+                    self.wfile.write(body)
+                except (BrokenPipeError, ConnectionResetError):
+                    pass
+
+            def log_message(self, *_args: object) -> None:
+                pass
+
+        provider = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        provider.daemon_threads = True
+        provider_thread = threading.Thread(target=provider.serve_forever, daemon=True)
+        provider_thread.start()
+        (profile / "models.yml").write_text(
+            "providers:\n  dvl08-local:\n"
+            f"    baseUrl: http://127.0.0.1:{provider.server_port}/v1\n"
+            "    api: openai-completions\n    auth: none\n    models:\n"
+            "      - id: scripted\n        name: DVL08 scripted fixture\n"
+            "        contextWindow: 32768\n        maxTokens: 1024\n")
+        argv = [str(OMP), "--print", "--model", "dvl08-local/scripted", "--smol", "dvl08-local/scripted",
+                "--no-session", "--no-pty", "--no-skills", "--no-rules", "--no-title",
+                "--no-extensions", "--extension", str(extension), "--no-tools", "--auto-approve",
+                "--max-time=45", "--cwd", str(project), "--session-dir", str(root / "sessions"),
+                "--config", str(root / "config.yml"), "Run the isolated native executor fixture only."]
+        env = _env(root)
+        env.update(DVL08_PROJECT=str(project), DVL08_SOURCE=str(source), DVL08_NATIVE_EXT=str(extension))
+        child: subprocess.Popen[bytes] | None = None
+        cleanup = {"parent_stopped": False, "provider_stopped": False, "remaining_owned": []}
+        try:
+            child = subprocess.Popen(argv, cwd=project, env=env, stdin=subprocess.DEVNULL,
+                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
+            start_ticks = _ticks(child.pid)
+            drained = _drain_owned(child, root, timeout=55)
+            event_path = root / "events.jsonl"
+            events = [json.loads(line) for line in event_path.read_text().splitlines()
+                      if line.strip()] if event_path.exists() else []
+            result_events = [event for event in events if event.get("name") == "native_result"]
+            positive = next((event for event in result_events if event.get("phase") == "positive"), None)
+            negative = next((event for event in result_events if event.get("phase") == "negative"), None)
+            typed = positive.get("structuredOutput") if positive else None
+            readbacks = [event for event in events if event.get("name") == "child_readback"]
+            return {"result": "native_child_observed" if positive else "inconclusive",
+                    "omp_version": version, "explorer_definition_sha256": agent_digest,
+                    "provider_port": provider.server_port, "provider_requests": requests[:12],
+                    "provider_request_counts": calls, "events": events[:100],
+                    "positive_result": positive, "negative_result": negative,
+                    "readbacks": readbacks,
+                    "strict_typed_data_observed": isinstance(typed, dict) and typed.get("status") == "valid"
+                    and typed.get("data") == {"schemaVersion": 1, "nonce": root.name, "observed": True},
+                    "negative_zero_send": negative is not None and calls["negative"] == 0,
+                    "sentinel_unchanged": sentinel.read_text() == "SAFE\n",
+                    "bash_target_absent": not bash_target.exists(),
+                    "parent_provider_zero": calls["parent"] == 0 and calls["unknown"] == 0,
+                    "guard_receipt_atomic_send": "unknown", "product_route_adopted": False,
+                    "all_q01_pass": False, "parent_pid": child.pid, "parent_start_ticks": start_ticks,
+                    "drain": drained, "cleanup": cleanup}
+        finally:
+            if child is not None and child.poll() is None:
+                for pid, ticks in _owned_processes(root).items():
+                    _kill_owned(pid, ticks, signal.SIGKILL)
+                try:
+                    child.wait(timeout=3)
+                except subprocess.TimeoutExpired:
+                    pass
+            cleanup["parent_stopped"] = child is None or child.poll() is not None
+            provider.shutdown()
+            provider.server_close()
+            provider_thread.join(timeout=3)
+            cleanup["provider_stopped"] = not provider_thread.is_alive()
+            cleanup["remaining_owned"] = sorted(_owned_processes(root))
