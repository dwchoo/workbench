# Copy this file to `.env` next to wb_inbox.py (or to ~/.config/omp-workbench/client.env),
# fill in the two values, and restrict it to yourself:  chmod 600 .env
# `.env` is ignored by git. Never commit a real key.

# The Hub address your key was issued for (scheme and host, optional port, no path).
WB_HUB_URL=http://YOUR-HUB-HOST:8780

# The API key from the Hub web page (Settings, API keys). Shown only once when it is issued.
WB_API_KEY=wbk_replace_me
